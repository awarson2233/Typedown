<UserControl
    x:Class="Typedown.WinUI.Controls.RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:u="using:Typedown.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ContentFrameBackgroundBrush" Color="Transparent"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContentFrameBackgroundBrush" Color="Transparent"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ContentFrameBackgroundBrush" ResourceKey="SystemColorBackgroundBrush"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent" ColumnSpacing="0" Padding="4,0,142,0">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="NavigationState">
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="BackVisible" GeneratedDuration="0:0:0.1">
                            <VisualTransition.Storyboard>
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackButton" Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TitlePanel" Storyboard.TargetProperty="Margin">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitlePanelTranslation" Storyboard.TargetProperty="X">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="-22"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualTransition.Storyboard>
                        </VisualTransition>
                        <VisualTransition To="BackCollapsed" GeneratedDuration="0:0:0.1">
                            <VisualTransition.Storyboard>
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackButton" Storyboard.TargetProperty="Visibility">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TitlePanel" Storyboard.TargetProperty="Margin">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="4,0,0,0"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TitlePanelTranslation" Storyboard.TargetProperty="X">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="22"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualTransition.Storyboard>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="BackVisible">
                        <VisualState.Setters>
                            <Setter Target="BackButton.Visibility" Value="Visible"/>
                            <Setter Target="TitlePanel.Margin" Value="0"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="BackCollapsed">
                        <VisualState.Setters>
                            <Setter Target="BackButton.Visibility" Value="Collapsed"/>
                            <Setter Target="TitlePanel.Margin" Value="4,0,0,0"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="32"
                Visibility="Collapsed"
                Style="{ThemeResource TitleBarBackButtonStyle}"
                Click="OnBackButtonClick"/>
            <Grid x:Name="TitlePanel" Grid.Column="1" ColumnSpacing="6" Margin="4,0,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TitlePanelTranslation"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/logo.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock
                Grid.Column="1"
                Text="{u:LocaleString Key=AppName}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"/>
            </Grid>
            <Grid x:Name="TitleDragRegion" Grid.Column="2" Background="Transparent"/>
        </Grid>
        <Frame x:Name="Frame" Background="{ThemeResource ContentFrameBackgroundBrush}" Grid.Row="1"/>
    </Grid>
</UserControl>
