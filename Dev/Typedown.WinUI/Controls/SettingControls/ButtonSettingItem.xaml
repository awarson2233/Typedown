<UserControl
    x:Class="Typedown.WinUI.Controls.ButtonSettingItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ExpanderHeaderBackground}"
    BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
    BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
    CornerRadius="{ThemeResource ControlCornerRadius}"
    HorizontalAlignment="Stretch"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <Button
        x:Name="RootButton"
        MinHeight="68"
        Padding="0"
        Click="OnClick"
        Command="{x:Bind Command, Mode=OneWay}"
        CommandParameter="{x:Bind CommandParameter, Mode=OneWay}"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
        BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
        BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
        Background="{x:Bind Background, Mode=OneWay}">
        <Grid
            Padding="16,12,16,12"
            ColumnSpacing="16"
            HorizontalAlignment="Stretch"
            Width="{Binding ActualWidth, ElementName=RootButton}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <ContentPresenter Content="{x:Bind Icon, Mode=OneWay}"/>
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ContentPresenter
                TextWrapping="Wrap"
                Content="{x:Bind Title, Mode=OneWay}"/>
                <ContentPresenter
                x:Name="ContentPresenter_Action"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondary}"
                Content="{x:Bind Description, Mode=OneWay}"/>
            </StackPanel>

            <ContentPresenter
                Grid.Column="2"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="{x:Bind HorizontalActionAlignment, Mode=OneWay}"
                Content="{x:Bind Action, Mode=OneWay}"/>

            <FontIcon Grid.Column="3" VerticalAlignment="Center" Glyph="&#xe974;" FontSize="16"/>
        </Grid>
    </Button>
</UserControl>
