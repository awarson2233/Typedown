<UserControl
    x:Class="Typedown.WinUI.Controls.LeftPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:Typedown.WinUI.Controls"
    xmlns:u="using:Typedown.WinUI.Controls"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <x:Double x:Key="TopNavigationViewPaneCustomContentMinWidth">0</x:Double>
    </UserControl.Resources>
    <Grid Background="{ThemeResource TypedownEditorBackgroundBrush}">
        <muxc:NavigationView
            x:Name="NavigationView"
            Visibility="Visible"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="OnSelectionChanged"
            IsSettingsVisible="False"
            PaneDisplayMode="Top">
            <muxc:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <StaticResource x:Key="NavigationViewContentGridBackground" ResourceKey="TypedownEditorBackgroundBrush"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource CardStrokeColorDefault}"/>
            </muxc:NavigationView.Resources>
            <!--<muxc:NavigationView.PaneFooter>
                <Button Width="32" Height="32" x:Name="SeatchButton" Click="OnSearchButtonClick" Margin="0,0,4,0" Style="{ThemeResource EllipsisIconButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xe721;"/>
                </Button>
            </muxc:NavigationView.PaneFooter>-->
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="{u:LocaleString Key=Files}" Tag="Folder" Name="Folder"/>
                <muxc:NavigationViewItem Content="{u:LocaleString Key=Outline}" Tag="Toc" Name="Toc"/>
            </muxc:NavigationView.MenuItems>
        </muxc:NavigationView>
        <Frame Margin="0,50,0,0" Visibility="Visible" x:Name="Frame">
            <Frame.Clip>
                <RectangleGeometry x:Name="FrameClip"/>
            </Frame.Clip>
        </Frame>
        <local:SearchPane x:Name="SearchPane" x:Load="{x:Bind IsSearchPaneOpen, Mode=OneWay}" Close="OnSearchPaneClose"/>
    </Grid>
</UserControl>
