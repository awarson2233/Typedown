<UserControl
    x:Class="Typedown.WinUI.Controls.MenuBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Controls"
    xmlns:items="using:Typedown.WinUI.Controls"
    xmlns:u="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewmodels="using:Typedown.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:AppViewModel}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Typedown.WinUI.Controls"
    xmlns:ui="using:Typedown.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <Grid BorderThickness="0,0,0,1" Margin="0,-4,0,0" BorderBrush="{ThemeResource CardStrokeColorDefault}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <muxc:MenuBar x:Name="MenuBarControl" IsEnabled="True">
            <items:FileItem x:Name="FileMenuItem"/>
            <items:EditItem x:Name="EditMenuItem"/>
            <items:ParagraphItem x:Name="ParagraphMenuItem" Visibility="Visible"/>
            <items:FormatItem x:Name="FormatMenuItem" Visibility="Visible"/>
            <items:ViewItem x:Name="ViewMenuItem"/>
        </muxc:MenuBar>
        <Grid x:Name="TitleGrid" Grid.Column="1">
            <TextBlock
                x:Name="TitleTextBlock"
                Margin="4,0,4,0"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text=""
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>
        <Button
            x:Name="SettingsButton"
            HorizontalAlignment="Right"
            Grid.Column="2"
            Margin="0,0,4,0"
            Style="{ThemeResource EllipsisIconButtonStyle}"
            CommandParameter="Settings/General"
            Click="OnSettingsButtonClick">
            <Viewbox Width="16" Height="16">
                <muxc:AnimatedIcon x:Name="Icon_Setting">
                    <muxc:AnimatedIcon.Source>
                        <animatedvisuals:AnimatedSettingsVisualSource/>
                    </muxc:AnimatedIcon.Source>
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:SymbolIconSource Symbol="Setting"/>
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Viewbox>
        </Button>
        <Grid x:Name="LeftDragBar" Grid.Column="0" Height="4" VerticalAlignment="Top"/>
        <Grid x:Name="RightDragBar" Grid.Column="1"/>
    </Grid>

</UserControl>
