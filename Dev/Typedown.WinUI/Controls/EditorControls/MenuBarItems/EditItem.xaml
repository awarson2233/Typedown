<local:MenuBarItemBase
    Title="Edit"
    x:Class="Typedown.WinUI.Controls.EditItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="using:Typedown.WinUI.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <MenuFlyoutItem x:Name="UndoItem" Text="Undo" IsEnabled="True"/>
    <MenuFlyoutItem x:Name="RedoItem" Text="Redo" IsEnabled="True"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="CutItem" Text="Cut" IsEnabled="True" CommandParameter="normal"/>
    <MenuFlyoutItem x:Name="CopyItem" Text="Copy" IsEnabled="True" CommandParameter="normal"/>
    <MenuFlyoutItem x:Name="PasteItem" Text="Paste" CommandParameter="normal"/>
    <MenuFlyoutSeparator Visibility="Visible"/>
    <MenuFlyoutItem x:Name="CopyAsPlainTextItem" Text="CopyAsPlainText" Visibility="Visible" CommandParameter="copyAsPlainText" IsEnabled="True"/>
    <MenuFlyoutItem x:Name="CopyAsMarkdownItem" Text="CopyAsMarkdown" Visibility="Visible" CommandParameter="copyAsMarkdown" IsEnabled="True"/>
    <MenuFlyoutItem x:Name="CopyAsHTMLCodeItem" Text="CopyAsHTMLCode" Visibility="Visible" CommandParameter="copyAsHtml" IsEnabled="True"/>
    <MenuFlyoutItem x:Name="PasteAsPlainTextItem" Text="PasteAsPlainText" Visibility="Visible" CommandParameter="pasteAsPlainText"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="DeleteItem" Text="Delete" IsEnabled="True"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="SelectAllItem" Text="SelectAll"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutSubItem Text="FindAndReplace">
        <MenuFlyoutItem x:Name="FindItem" Text="Find" CommandParameter="Search"/>
        <MenuFlyoutItem x:Name="FindNextItem" Text="FindNext" CommandParameter="next"/>
        <MenuFlyoutItem x:Name="FindPreviousItem" Text="FindPrevious" CommandParameter="prev"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem x:Name="ReplaceItem" Text="Replace" CommandParameter="Replace"/>
    </MenuFlyoutSubItem>
</local:MenuBarItemBase>
