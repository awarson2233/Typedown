<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="SettingsSectionBreakMargin">0,24,0,8</Thickness>

    <Style x:Key="SettingsPageRootStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <Style x:Key="SettingsSectionHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SettingsListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style x:Key="SettingsInlineActionGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="SettingsFormGridStyle" TargetType="Grid">
        <Setter Property="RowSpacing" Value="12"/>
        <Setter Property="ColumnSpacing" Value="16"/>
        <Setter Property="Margin" Value="-16,0,0,0"/>
    </Style>

    <Style x:Key="SettingsMultilineEditorPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="Margin" Value="-16,0,0,0"/>
    </Style>

    <Style x:Key="SettingsInlineChoicePanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="16"/>
    </Style>
</ResourceDictionary>
