<Page
    x:Class="Typedown.WinUI.Pages.SettingPages.ViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:u="using:Typedown.WinUI.Controls">
    <StackPanel Spacing="8">
        <TextBlock Text="{u:LocaleString Key=View.Window}" Margin="0,0,0,4"/>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.AppTheme.Title}" Description="{u:LocaleString Key=View.AppTheme.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe790;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ComboBox MinWidth="200" SelectedIndex="0">
                <ComboBoxItem Content="{u:LocaleString Key=UseSystemSetting}"/>
                <ComboBoxItem Content="{u:LocaleString Key=View.AppTheme.Light}"/>
                <ComboBoxItem Content="{u:LocaleString Key=View.AppTheme.Dark}"/>
            </ComboBox>
        </toolkit:SettingsCard>
        <toolkit:SettingsExpander Header="{u:LocaleString Key=View.UseMicaMaterial.Title}" Description="{u:LocaleString Key=View.UseMicaMaterial.Description}">
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xf4a5;"/>
            </toolkit:SettingsExpander.HeaderIcon>
            <ToggleSwitch IsOn="True"/>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard Header="{u:LocaleString Key=View.UseEditorMicaMaterial.Title}" IsActionIconVisible="False">
                    <ToggleSwitch IsOn="True"/>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.AnimationEnable.Title}" Description="{u:LocaleString Key=View.AnimationEnable.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe8be;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="True"/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.Topmost.Title}" Description="{u:LocaleString Key=View.Topmost.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xee40;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch/>
        </toolkit:SettingsCard>

        <TextBlock Text="{u:LocaleString Key=View.Layout}" Margin="0,16,0,4"/>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.AppCompactMode.Title}" Description="{u:LocaleString Key=View.AppCompactMode.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xf246;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.StatusBarOpen.Title}" Description="{u:LocaleString Key=View.StatusBarOpen.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe90e;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="True"/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=View.SidePaneOpen.Title}" Description="{u:LocaleString Key=View.SidePaneOpen.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xea4b;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="True"/>
        </toolkit:SettingsCard>
    </StackPanel>
</Page>
