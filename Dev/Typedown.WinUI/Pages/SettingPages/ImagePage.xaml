<Page
    x:Class="Typedown.WinUI.Pages.SettingPages.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="8">
        <TextBlock Text="General" Margin="0,0,0,4"/>
        <toolkit:SettingsExpander Header="Insert action" Description="Choose how images are inserted into Markdown.">
            <toolkit:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xe91b;"/>
            </toolkit:SettingsExpander.HeaderIcon>
            <toolkit:SettingsExpander.Items>
                <toolkit:SettingsCard Header="Clipboard image" Description="Action for pasted images." IsActionIconVisible="False">
                    <ComboBox MinWidth="200" SelectedIndex="0">
                        <ComboBoxItem Content="Copy to folder"/>
                        <ComboBoxItem Content="Use original path"/>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Local image" Description="Action for selected local images." IsActionIconVisible="False">
                    <ComboBox MinWidth="200" SelectedIndex="0">
                        <ComboBoxItem Content="Copy to folder"/>
                        <ComboBoxItem Content="Use original path"/>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Web image" Description="Action for remote images." IsActionIconVisible="False">
                    <ComboBox MinWidth="200" SelectedIndex="0">
                        <ComboBoxItem Content="Keep URL"/>
                        <ComboBoxItem Content="Download"/>
                    </ComboBox>
                </toolkit:SettingsCard>
            </toolkit:SettingsExpander.Items>
        </toolkit:SettingsExpander>
        <toolkit:SettingsCard Header="Default image base path" Description="Folder used when Typedown copies images." IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe8b7;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <Grid Width="320" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="images"/>
                <Button Grid.Column="1" Content="Browse"/>
            </Grid>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Prefer relative image paths" Description="Insert relative image paths when possible." IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xf003;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="True"/>
        </toolkit:SettingsCard>

        <TextBlock Text="Upload" Margin="0,16,0,4"/>
        <toolkit:SettingsCard Header="Upload configs" Description="Manage image upload targets." IsClickEnabled="True">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xee71;"/>
            </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
    </StackPanel>
</Page>
