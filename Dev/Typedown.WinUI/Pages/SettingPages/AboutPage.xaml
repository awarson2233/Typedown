<Page
    x:Class="Typedown.WinUI.Pages.SettingPages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="8">
        <TextBlock Text="About app" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <toolkit:SettingsCard Header="Typedown" Description="A Markdown editor focused on clean writing and preview." IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe946;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Open source software" Description="View credits for open source components." IsClickEnabled="True">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe774;"/>
            </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Microsoft Store page" Description="Open Typedown in Microsoft Store." IsClickEnabled="True">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe719;"/>
            </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="Feedback" Description="Send feedback about Typedown." IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe939;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <Button MinWidth="120" Content="Feedback"/>
        </toolkit:SettingsCard>
    </StackPanel>
</Page>
