<Page
    x:Class="Typedown.WinUI.Pages.SettingPages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:u="using:Typedown.WinUI.Controls">
    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">
        <TextBlock Text="{u:LocaleString Key=About.AboutApp}" FontWeight="SemiBold" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
        <toolkit:SettingsCard Header="{u:LocaleString Key=AppName}" Description="{u:LocaleString Key=About.Introduction}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe946;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=OpenSourceSoftware}" Description="View credits for open source components." IsClickEnabled="True" Click="OnOpenSourceSoftwareClick">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe774;"/>
            </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=About.AppStorePage}" Description="Open Typedown in Microsoft Store." IsClickEnabled="True" Click="OnMicrosoftStorePageClick">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe719;"/>
            </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=Feedback}" Description="{u:LocaleString Key=About.SendFeedback}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xe939;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <Button MinWidth="120" Content="{u:LocaleString Key=Feedback}" Click="OnFeedbackClick"/>
        </toolkit:SettingsCard>
    </StackPanel>
</Page>
