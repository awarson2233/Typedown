<Page
    x:Class="Typedown.WinUI.Pages.SettingPages.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.WinUI.Pages.SettingPages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Typedown.WinUI.Controls"
    xmlns:models="using:Typedown.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:u="using:Typedown.WinUI.Controls"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Page.Resources>
        <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{ThemeResource SystemFillColorCritical}"/>
        <MenuFlyout x:Key="ConfigItemMenuFlyout" x:Name="ConfigItemMenuFlyout">
            <MenuFlyoutItem Text="{u:LocaleString Key=Delete}" Click="OnDeleteClick"/>
        </MenuFlyout>
    </Page.Resources>

    <StackPanel Style="{StaticResource SettingsPageRootStackPanelStyle}">

        <TextBlock Text="{u:LocaleString Key=General}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
        <toolkit:SettingsCard Header="{u:LocaleString Key=Export.OpenFolderAfterExport.Title}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xed25;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.SettingsViewModel.OpenFolderAfterExport, Mode=TwoWay}"/>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard Header="{u:LocaleString Key=Export.AddConfig.Title}" Description="{u:LocaleString Key=Export.AddConfig.Description}" IsActionIconVisible="False">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xed0e;"/>
            </toolkit:SettingsCard.HeaderIcon>
            <Button Style="{ThemeResource AccentButtonStyle}" MinWidth="100" Click="OnAddButtonClick">
                <TextBlock Text="{u:LocaleString Key=Add}"/>
            </Button>
        </toolkit:SettingsCard>

        <TextBlock Text="{u:LocaleString Key=Export.Configs}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="{StaticResource SettingsSectionBreakMargin}" Visibility="{x:Bind ConfigItemsTitleVisibility(FileExport.ExportConfigs), Mode=OneWay}"/>
        <ListView
            x:Name="ConfigListView"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            ItemsSource="{x:Bind FileExport.ExportConfigs}"
            ItemContainerStyle="{StaticResource SettingsListViewItemStyle}"
            SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition/>
                    <ContentThemeTransition/>
                    <ReorderThemeTransition/>
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ExportConfig">
                    <toolkit:SettingsCard
                        Header="{x:Bind Name, Mode=OneWay}"
                        Description="{x:Bind local:ExportPage.GetConfigItemDescription(Type), Mode=OneWay}"
                        Tag="{x:Bind}"
                        IsClickEnabled="True"
                        Click="{x:Bind local:ExportPage.OnConfigItemClick}"
                        ContextFlyout="{StaticResource ConfigItemMenuFlyout}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </StackPanel>
</Page>
