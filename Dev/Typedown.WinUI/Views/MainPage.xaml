<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Typedown.WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Typedown.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Typedown.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#F4EFE5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="40,36,40,20" Spacing="10">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="#19363B"
                Text="Typedown WinUI3 Platform Services" />
            <TextBlock
                FontSize="16"
                Foreground="#4B5B5E"
                Text="Phase 11 adds the first WinUI3 WebView2 editor host slice while keeping the shell on Typedown.Core.Contracts and away from the legacy XAML host." />
            <TextBlock
                FontSize="14"
                Foreground="#6A7A7D"
                Text="{x:Bind ContractsProbeSummary}" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="40,10,40,40" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="White"
                BorderBrush="#D8CBB8"
                BorderThickness="1"
                CornerRadius="18"
                Padding="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#19363B"
                        Text="Phase 11 editable editor smoke" />
                    <controls:WinUIEditorHost Grid.Row="1" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="#19363B"
                CornerRadius="18"
                Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Migration boundary" />
                    <ItemsRepeater ItemsSource="{x:Bind ValidatedItems}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="15"
                                    Foreground="#F4EFE5"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater ItemsSource="{x:Bind ServiceItems}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="15"
                                    Foreground="#F4EFE5"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <ItemsRepeater ItemsSource="{x:Bind DeferredItems}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="15"
                                    Foreground="#F4EFE5"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
