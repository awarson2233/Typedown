<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TypedownXamlUIProjectDir Condition="'$(TypedownXamlUIProjectDir)' == ''">$(MSBuildProjectDirectory)\..\Typedown.XamlUI\</TypedownXamlUIProjectDir>
		<TypedownXamlUIProject>$(TypedownXamlUIProjectDir)Typedown.XamlUI.csproj</TypedownXamlUIProject>
		<ManifestTool>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x86\mt.exe</ManifestTool>
		<MakePri>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x86\makepri.exe</MakePri>
	</PropertyGroup>

	<Target Name="EnsureTypedownXamlUIDependency" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(TypedownXamlUIProject)')"
			   Text="Missing required in-repo legacy XAML host: '$(TypedownXamlUIProject)'. See docs/xamlui-dependency.md for the expected repository layout." />
	</Target>

	<Import Project="$(TypedownXamlUIProjectDir)buildTransitive\Typedown.XamlUI.props" Condition="Exists('$(TypedownXamlUIProjectDir)buildTransitive\Typedown.XamlUI.props')" />

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Platforms>x64;x86;ARM64</Platforms>
		<TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
		<TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
		<AssetTargetFallback>uap10.0.26100</AssetTargetFallback>
		<UseUwp>true</UseUwp>
		<StartupObject>Typedown.Program</StartupObject>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
		<!--<PublishTrimmed>true</PublishTrimmed>-->
		<Version>1.2.19</Version>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Configurations>Debug;Release;Debug_Local</Configurations>
		<WebView2UseWinRT>false</WebView2UseWinRT>
		<WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
		<WebView2LoaderPreference>Dynamic</WebView2LoaderPreference>
		<WebView2NeverCopyLoaderDllToOutputDirectory>false</WebView2NeverCopyLoaderDllToOutputDirectory>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug_Local'">
		<VCRTForwarders-IncludeDebugCRT>true</VCRTForwarders-IncludeDebugCRT>
		<DefineConstants>$(DefineConstants);DEBUG_LOCAL</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)'=='ARM64'">
	  <SelfContained>true</SelfContained>
	  <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x86'">
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
		<PackageReference Include="Microsoft.VCRTForwarders.140" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="PdfiumViewer.Native.x86_64.no_v8-no_xfa" Version="2018.4.8.256" />
		<PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Typedown.Core\Typedown.Core.csproj" />
		<ProjectReference Include="$(TypedownXamlUIProject)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="Microsoft.VCRTForwarders.140" Version="1.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Resources\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Resources\Statics\**" CopyToOutputDirectory="Always" Link="Resources\Statics\%(RecursiveDir)\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="$(TypedownXamlUIProjectDir)runtimes\win10-$(Platform)\native\Microsoft.UI.Xaml.dll" Condition="Exists('$(TypedownXamlUIProjectDir)runtimes\win10-$(Platform)\native\Microsoft.UI.Xaml.dll')" Link="Microsoft.UI.Xaml.dll" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="$(TypedownXamlUIProjectDir)lib\Microsoft.UI.Xaml.pri" Link="Microsoft.UI.Xaml.pri" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="$(TypedownXamlUIProjectDir)lib\Microsoft.UI.Xaml.xml" Link="Microsoft.UI.Xaml.xml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="MicrosoftEdgeWebview2Setup.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<Import Project="$(TypedownXamlUIProjectDir)buildTransitive\Typedown.XamlUI.targets" Condition="Exists('$(TypedownXamlUIProjectDir)buildTransitive\Typedown.XamlUI.targets')" />
	
</Project>
