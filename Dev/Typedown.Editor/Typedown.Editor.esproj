<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.VisualStudio.JavaScript.Sdk" Version="0.5.45-alpha" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug_Local|AnyCPU">
      <Configuration>Debug_Local</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <StartupCommand>set BROWSER=none&amp;&amp;npm start</StartupCommand>
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Jest</JavaScriptTestFramework>
    <BuildWorkingDirectory>$(MSBuildProjectDirectory)</BuildWorkingDirectory>
    <!-- Command to run on project build -->
    <BuildCommand>yarn build</BuildCommand>
    <!-- Publish depends on Build; leave this empty so the fixed SDK does not run the frontend build twice. -->
    <ProductionBuildCommand></ProductionBuildCommand>
    <!-- config-overrides.js writes the production bundle directly into the WinUI staging directory. -->
    <BuildOutputFolder>$(MSBuildProjectDirectory)\..\Typedown.WinUI\Resources\Statics</BuildOutputFolder>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.VisualStudio.JavaScript.Sdk" Version="0.5.45-alpha" />

  <!-- The fixed SDK's DebugEnsureNodeEnv uses npm. Override it and restore only from yarn.lock. -->
  <Target Name="EnsureYarnNodeEnv"
          BeforeTargets="CoreCompile"
          Condition="!Exists('$(BuildWorkingDirectory)\node_modules')">
    <Message Importance="high" Text="Restoring Typedown.Editor dependencies with Yarn." />
    <Exec WorkingDirectory="$(BuildWorkingDirectory)" Command="yarn install --frozen-lockfile" />
  </Target>

  <Target Name="DebugEnsureNodeEnv" DependsOnTargets="EnsureYarnNodeEnv" />
</Project>