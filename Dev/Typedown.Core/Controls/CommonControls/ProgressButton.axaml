<Button
    x:Class="Typedown.Core.Controls.ProgressButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Typedown.Core.Controls"
    xmlns:muxc="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls" 
    Unloaded="OnUnloaded">
    <Grid>
        <ContentPresenter x:Name="ButtonContent" Content="{Binding Content, RelativeSource={RelativeSource AncestorType=local:ProgressButton}}" IsVisible="{Binding !IsLoading, RelativeSource={RelativeSource AncestorType=local:ProgressButton}}"/>
        <ProgressBar IsIndeterminate="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=local:ProgressButton}}" IsVisible="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=local:ProgressButton}}" Height="16" Width="16" VerticalAlignment="Center"/>
    </Grid>
</Button>

