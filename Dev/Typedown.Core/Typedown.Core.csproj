<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TypedownXamlUIProjectDir Condition="'$(TypedownXamlUIProjectDir)' == ''">$(MSBuildProjectDirectory)\..\Typedown.XamlUI\</TypedownXamlUIProjectDir>
		<TypedownXamlUIProject>$(TypedownXamlUIProjectDir)Typedown.XamlUI.csproj</TypedownXamlUIProject>
		<OutputType>Library</OutputType>
		<TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
		<TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
		<SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<UseUwp>true</UseUwp>
		<Platforms>x86;x64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<DefaultLanguage>zh-CN</DefaultLanguage>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<EnableMsixTooling>true</EnableMsixTooling>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>$(NoWarn);CA1416;CS8981</NoWarn>
		<AppxBundlePlatforms Condition="'$(Platform)' == 'x64'">x64</AppxBundlePlatforms>
		<AppxBundlePlatforms Condition="'$(Platform)' == 'x86'">x86</AppxBundlePlatforms>
		<CsWinRTIncludes>
			Microsoft.UI.Xaml;
			Microsoft.UI.Xaml.CustomAttributes;
			Microsoft.UI.Xaml.Controls;
			Microsoft.UI.Xaml.Controls.AnimatedVisuals;
			Microsoft.UI.Xaml.Controls.Primitives;
		</CsWinRTIncludes>
	</PropertyGroup>

	<Target Name="EnsureTypedownXamlUIDependency" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(TypedownXamlUIProject)')" Text="Missing required in-repo legacy XAML host: '$(TypedownXamlUIProject)'. See docs/xamlui-dependency.md for the expected repository layout." />
	</Target>

	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x86'">
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="obj_test\**" />
	  <EmbeddedResource Remove="obj_test\**" />
	  <None Remove="obj_test\**" />
	  <Page Remove="obj_test\**" />
	  <PRIResource Remove="obj_test\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
		<PackageReference Include="System.Reactive" Version="6.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Typedown.Core.Contracts\Typedown.Core.Contracts.csproj" />
		<ProjectReference Include="$(TypedownXamlUIProject)" />
	</ItemGroup>

</Project>
