<UserControl
    x:Class="Typedown.Core.Pages.SettingPages.ExportConfigPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Typedown.Core.Pages.SettingPages" 
    xmlns:export="clr-namespace:Typedown.Core.Controls.SettingControls.SettingItems.ExportConfigItems"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <export:CommonConfig 
        ExportConfig="{x:Bind ExportConfig, Mode=OneWay}" 
        Detail="{x:Bind GetExportConfigItem(ExportConfig.Type), Mode=OneWay}"/>
</UserControl>
