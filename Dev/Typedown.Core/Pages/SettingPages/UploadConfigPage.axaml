<UserControl
    x:Class="Typedown.Core.Pages.SettingPages.UploadConfigPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Typedown.Core.Pages.SettingPages" 
    xmlns:upload="clr-namespace:Typedown.Core.Controls.SettingControls.SettingItems.UploadConfigItems"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <upload:CommonConfig 
        ImageUploadConfig="{x:Bind ImageUploadConfig, Mode=OneWay}" 
        Detail="{x:Bind GetUploadConfigItem(ImageUploadConfig.Method), Mode=OneWay}"/>
</UserControl>
